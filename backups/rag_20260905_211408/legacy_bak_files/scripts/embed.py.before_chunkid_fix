import json
import requests
from pathlib import Path


INPUT_FILE = Path("/opt/ai/rag/database/chunks.json")
OUTPUT_FILE = Path("/opt/ai/rag/database/embeddings.json")

OLLAMA_URL = "http://localhost:11434/api/embed"
MODEL = "embeddinggemma:latest"


def get_chunk_key(chunk):
    """
    Identificador lógico e estável do chunk.

    Mesmo que o script seja executado novamente,
    o mesmo documento/página/chunk terá a mesma chave.
    """

    return (
        f"{chunk['document']}"
        f"|{chunk['page']}"
        f"|{chunk['chunk']}"
    )


def main():

    # ---------------------------------------------------------
    # 1. Carrega chunks
    # ---------------------------------------------------------

    with open(INPUT_FILE, "r", encoding="utf-8") as f:
        chunks = json.load(f)

    print(f"Chunks encontrados: {len(chunks)}")
    print(f"Modelo de embedding: {MODEL}")
    print()


    # ---------------------------------------------------------
    # 2. Carrega embeddings existentes
    # ---------------------------------------------------------

    existing = {}

    if OUTPUT_FILE.exists():

        print("Carregando embeddings existentes...")

        with open(OUTPUT_FILE, "r", encoding="utf-8") as f:
            old_embeddings = json.load(f)

        for item in old_embeddings:

            key = get_chunk_key(item)

            existing[key] = item

        print(
            f"Embeddings existentes: {len(existing)}"
        )

    else:

        print("Nenhum embedding existente encontrado.")

    print()


    # ---------------------------------------------------------
    # 3. Processa chunks
    # ---------------------------------------------------------

    results = []

    novos = 0
    reutilizados = 0

    total = len(chunks)

    for i, chunk in enumerate(chunks, start=1):

        key = get_chunk_key(chunk)


        # -----------------------------------------------------
        # Já existe
        # -----------------------------------------------------

        if key in existing:

            print(
                f"[{i}/{total}] "
                f"REUTILIZANDO "
                f"{chunk['document']} "
                f"Página {chunk['page']} "
                f"Chunk {chunk['chunk']}"
            )

            results.append(existing[key])

            reutilizados += 1

            continue


        # -----------------------------------------------------
        # Novo chunk
        # -----------------------------------------------------

        text = chunk["text"]

        print(
            f"[{i}/{total}] "
            f"NOVO → embedding "
            f"{chunk['document']} "
            f"Página {chunk['page']} "
            f"Chunk {chunk['chunk']} "
            f"({len(text)} caracteres)"
        )


        response = requests.post(
            OLLAMA_URL,
            json={
                "model": MODEL,
                "input": text
            },
            timeout=300
        )

        response.raise_for_status()

        data = response.json()

        embedding = data["embeddings"][0]


        item = {
            **chunk,
            "embedding": embedding
        }


        results.append(item)

        novos += 1

        print(
            f"    embedding: "
            f"{len(embedding)} dimensões"
        )


    # ---------------------------------------------------------
    # 4. Salva resultado
    # ---------------------------------------------------------

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            results,
            f,
            ensure_ascii=False
        )


    # ---------------------------------------------------------
    # 5. Resumo
    # ---------------------------------------------------------

    print()
    print("========================================")
    print("Embedding concluído")
    print("========================================")
    print(f"Chunks encontrados : {total}")
    print(f"Reutilizados       : {reutilizados}")
    print(f"Novos embeddings   : {novos}")
    print(f"Total final        : {len(results)}")
    print(f"Arquivo            : {OUTPUT_FILE}")
    print("========================================")


if __name__ == "__main__":
    main()