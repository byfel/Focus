<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Suporte AI | Login</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(37, 99, 235, 0.16),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(14, 165, 233, 0.10),
                    transparent 35%
                ),
                #080b10;

            color: #f1f5f9;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;
        }


        /* =====================================================
           BACKGROUND
        ===================================================== */

        .background-grid {

            position: fixed;

            inset: 0;

            pointer-events: none;

            opacity: 0.16;

            background-image:

                linear-gradient(
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                ),

                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.025) 1px,
                    transparent 1px
                );

            background-size: 50px 50px;

            mask-image:
                linear-gradient(
                    to bottom,
                    black,
                    transparent
                );
        }


        /* =====================================================
           LOGIN CONTAINER
        ===================================================== */

        .login-wrapper {

            position: relative;

            width: 100%;

            max-width: 430px;

            padding: 24px;
        }


        /* =====================================================
           LOGIN CARD
        ===================================================== */

        .login-card {

            background:
                rgba(15, 18, 24, 0.88);

            border:

                1px solid
                rgba(255,255,255,0.08);

            border-radius: 18px;

            padding: 42px;

            box-shadow:

                0 30px 80px
                rgba(0,0,0,0.55),

                0 0 0 1px
                rgba(255,255,255,0.02);

            backdrop-filter: blur(18px);

            -webkit-backdrop-filter: blur(18px);
        }


        /* =====================================================
           LOGO
        ===================================================== */

        .logo {

            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 26px;
        }


        .logo-icon {

            width: 52px;

            height: 52px;

            border-radius: 14px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #0ea5e9
                );

            box-shadow:

                0 10px 30px
                rgba(37,99,235,0.35);

            font-size: 25px;

            font-weight: 700;
        }


        /* =====================================================
           TITLES
        ===================================================== */

        h1 {

            margin: 0;

            text-align: center;

            font-size: 25px;

            font-weight: 650;

            letter-spacing: -0.4px;
        }


        .subtitle {

            margin-top: 9px;

            text-align: center;

            color: #8b96a7;

            font-size: 14px;

            line-height: 1.5;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .form {

            margin-top: 34px;
        }


        .field {

            margin-bottom: 20px;
        }


        label {

            display: block;

            margin-bottom: 8px;

            font-size: 13px;

            font-weight: 500;

            color: #cbd5e1;
        }


        input {

            width: 100%;

            height: 48px;

            padding: 0 15px;

            border-radius: 9px;

            border:
                1px solid
                #2b3442;

            background: #10141b;

            color: #f8fafc;

            font-size: 15px;

            outline: none;

            transition:
                border-color .2s,
                box-shadow .2s,
                background .2s;
        }


        input::placeholder {

            color: #586273;
        }


        input:focus {

            border-color: #3b82f6;

            background: #121821;

            box-shadow:
                0 0 0 3px
                rgba(59,130,246,0.13);
        }


        /* =====================================================
           LOGIN BUTTON
        ===================================================== */

        .login-button {

            width: 100%;

            height: 48px;

            margin-top: 8px;

            border: 0;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #1976d2
                );

            color: white;

            font-size: 15px;

            font-weight: 600;

            cursor: pointer;

            transition:
                transform .15s,
                filter .15s,
                box-shadow .15s;

            box-shadow:
                0 8px 25px
                rgba(37,99,235,0.25);
        }


        .login-button:hover {

            filter: brightness(1.08);

            box-shadow:
                0 10px 30px
                rgba(37,99,235,0.35);
        }


        .login-button:active {

            transform: scale(0.99);
        }


        .login-button:disabled {

            opacity: .6;

            cursor: wait;

            box-shadow: none;
        }


        /* =====================================================
           STATUS
        ===================================================== */

        .status {

            min-height: 22px;

            margin-top: 17px;

            text-align: center;

            font-size: 13px;

            color: #8b96a7;
        }


        .status.error {

            color: #f87171;
        }


        .status.success {

            color: #4ade80;
        }


        /* =====================================================
           CORPORATE INFO
        ===================================================== */

        .security-info {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            margin-top: 25px;

            padding-top: 20px;

            border-top:
                1px solid
                rgba(255,255,255,0.06);

            color: #667085;

            font-size: 12px;
        }


        .security-dot {

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background: #22c55e;

            box-shadow:
                0 0 8px
                rgba(34,197,94,.6);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            margin-top: 24px;

            text-align: center;

            color: #4b5563;

            font-size: 11px;

            line-height: 1.5;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 500px) {

            .login-card {

                padding: 32px 25px;

                border-radius: 15px;
            }

            .login-wrapper {

                padding: 18px;
            }
        }

    </style>

</head>


<body>

<div class="background-grid"></div>


<div class="login-wrapper">

    <div class="login-card">


        <!-- LOGO -->

        <div class="logo">

            <div class="logo-icon">
                AI
            </div>

        </div>


        <!-- TITULO -->

        <h1>
            SUPORTE AI
        </h1>

        <div class="subtitle">

            Assistente Técnico de Mídias

            <br>

            Acesso ao ambiente de suporte inteligente

        </div>


        <!-- FORM -->

        <form
            class="form"
            id="loginForm"
        >


            <div class="field">

                <label for="username">
                    Usuário
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Digite seu usuário"
                    autocomplete="username"
                    required
                >

            </div>


            <div class="field">

                <label for="password">
                    Senha
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Digite sua senha"
                    autocomplete="current-password"
                    required
                >

            </div>


            <button
                type="submit"
                class="login-button"
                id="loginButton"
            >
                Entrar
            </button>


            <div
                class="status"
                id="status"
            ></div>


        </form>


        <!-- SEGURANÇA -->

        <div class="security-info">

            <span class="security-dot"></span>

            Ambiente protegido

        </div>


        <div class="footer">

            SUPORTE AI · Assistente de documentação técnica

            <br>

            Acesso restrito a usuários autorizados

        </div>


    </div>

</div>


<script>

const form =
    document.getElementById("loginForm");

const button =
    document.getElementById("loginButton");

const status =
    document.getElementById("status");


form.addEventListener(
    "submit",
    async function(event) {

        event.preventDefault();


        const username =
            document
                .getElementById("username")
                .value
                .trim();

        const password =
            document
                .getElementById("password")
                .value;


        if (!username || !password) {

            status.textContent =
                "Preencha usuário e senha.";

            status.className =
                "status error";

            return;
        }


        button.disabled = true;

        button.textContent =
            "Autenticando...";

        status.textContent =
            "Validando credenciais...";

        status.className =
            "status";


        try {

            /*
             * FUTURA AUTENTICAÇÃO LDAP
             *
             * Aqui iremos chamar nossa API:
             *
             * POST /login
             *
             * {
             *     "username": "...",
             *     "password": "..."
             * }
             *
             */


            const response =
                await fetch(
                    "/login",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify({
                            username: username,
                            password: password
                        })
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "Usuário ou senha inválidos."
                );

            }


            const data =
                await response.json();


            status.textContent =
                "Login realizado com sucesso.";

            status.className =
                "status success";


            /*
             * Depois da autenticação,
             * iremos redirecionar para:
             *
             * /assistant
             *
             */


            setTimeout(
                function() {

                    window.location.href =
                        "/app";

                },
                500
            );


        }

        catch (error) {

            status.textContent =
                error.message ||
                "Não foi possível realizar o login.";

            status.className =
                "status error";

        }

        finally {

            button.disabled = false;

            button.textContent =
                "Entrar";

        }

    }
);

</script>

</body>

</html>